// File name: projects/1/Or.hdl
/**
 * Or gate:
 * if (a or b) out = 1, else out = 0 
 */


 /*
 NOTE-TO-SELF:
 Syntax errors can occur:
 Don't use underscore
 
 */

 /*
 A script file called run.sh has been added for automating the pushing-to-remote respository process.
 */
CHIP Or {
    IN a, b;
    OUT out;

    PARTS:
    //// Replace this comment with your code.
    Not(in=a, out=notAout);
    Not(in=b, out=notBout);
    Nand(a=notAout, b=notBout, out=out);
}
