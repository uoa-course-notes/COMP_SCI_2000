/** Hello world program **/
/*
Each Jack program must include at least one class named Main, and this class must include 
at least one function named Main.main 
*/
class Main{
    function void main(){
        // Prints some text using the standard library 
        do Output.printString("Hello World");
        do Output.printString(); // new line 
        
        var Array a; 
        var int length;
        var int i, sum;


        let length = Keyboard.readInt("How many numbers? ");
        let a= Array.new(length); // Constructs the array (allocate memory in the heap)
        let i = 0;


        while (i < length) {
            let a[i] = Keyboard.readInt("Enter the next number: ");
            let sum = sum + a[i];
            let i = i + 1;
        }

        do Output.printString("The avergae is: ");
        do Output.printInt(sum / length);
        do Output.println();
        return;
    }

}

// Provides the Fraction type and related services.
class Fraction{
    field int numerator, denominator;

    // Constructs a new (and reduced) fraction from the given numerator and denominator 
    constructor Fraction new(int a, int b){
        let numerator = a; 
        let denominator= b;
        do reduce(); // if a/b is not displayed in its simplest form, reduce it 
        return this;
    }

    // Reduce this fraction 
    method void reduce(){
        var int g;
        let g = Fraction.gcd(numerator, denominator);
        if (g > 1){
            let numerator = numerator/g;
            let denominator = denominator / g;
        }
        return;
    }

    // Computes GCD(a, b)
    function int gcd(int a, int b){
        var int r;
        while (~(b==0)){
            let r = a - (b* a /b);
            let a= b;
            let b = r;
        }
        return a;
    }

    // Accessors and mutators 
    method int getNumerator(){return numerator;}
    method int getDenominator(){return denominator;}


    // Returns the sum of this fraction and another 
    method Fraction plus(Fraction other){
        var int sum;
        let sum = (number * other.getDenominator()) + (other.getNumerator() * denominator);

        return Fraction.new(sum, denominator * other.getDenominator());
    }

    // prints this fraction 
    method void print(){
        do Output.printInt(numerator);
        do Output.printString("/");
        do Output.printInt(denominator);
        return ;
    }


}



