// Calculates a = x*y
// a is a local variable
// x & y are static variables

// Initialize local variables
push constant 0
pop temp 0 // sum = 0
push constant 0
pop temp 1 // sign = 0

// Check if x < 0, and adjust sign accordingly
push static 0
push constant 0
lt
if-goto NEGATE_X
goto CHECK_Y

label NEGATE_X
push static 0
neg
pop static 0
push constant 1
pop temp 1 // sign = 1

label CHECK_Y
// Check if y < 0, and adjust sign accordingly
push static 1
push constant 0
lt
if-goto NEGATE_Y
goto MULTIPLY

label NEGATE_Y
push static 1
neg
pop static 1
push temp 1
push constant 1
add
pop temp 1 // sign = sign + 1

label MULTIPLY
// Perform multiplication using repeated addition
push static 1
pop temp 2 // temp2 = y

label START_LOOP
// Break condition
push temp 2
push constant 0
eq
if-goto END_LOOP

// sum = sum + x
push temp 0
push static 0
add
pop temp 0

// temp2 = temp2 - 1
push temp 2
push constant 1
sub
pop temp 2

goto START_LOOP

label END_LOOP
// Adjust the result based on the sign
push temp 1
push constant 1
eq
if-goto NEGATE_RESULT
goto STORE_RESULT

label NEGATE_RESULT
push temp 0
neg
pop temp 0

label STORE_RESULT
// Store the result in local 0
push temp 0
pop local 0

label END
goto END
