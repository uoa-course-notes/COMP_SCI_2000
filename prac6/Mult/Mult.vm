// Mult.vm
// Calculates a = x * y
// a is a local variable
// x & y are static variables

// Initialize temp 0 (sum) to 0
push constant 0
pop temp 0

// Load x into temp 1
push static 0
pop temp 1

// Load y into temp 2
push static 1
pop temp 2

// Check if x is negative and negate if necessary
push temp 1
push constant 0
lt
if-goto X_NEGATIVE

goto CHECK_Y

label X_NEGATIVE
push temp 1
neg
pop temp 1
push constant 1
neg
pop temp 3 // Set flag for x was negative

label CHECK_Y
push temp 2
push constant 0
lt
if-goto Y_NEGATIVE

goto MULTIPLICATION_LOOP

label Y_NEGATIVE
push temp 2
neg
pop temp 2
push constant 1
neg
pop temp 4 // Set flag for y was negative

// Multiplication loop
label MULTIPLICATION_LOOP
push temp 2
push constant 0
eq
if-goto END_MULTIPLICATION

// sum = sum + x
push temp 0
push temp 1
add
pop temp 0

// Decrement y
push temp 2
push constant 1
sub
pop temp 2

goto MULTIPLICATION_LOOP

label END_MULTIPLICATION
// Check if the result should be negative
push temp 3
push temp 4
add
push constant 0
lt
if-goto NEGATE_RESULT

goto FINAL_RESULT

label NEGATE_RESULT
push temp 0
neg
pop temp 0

label FINAL_RESULT
push temp 0
pop local 0

label END
goto END
